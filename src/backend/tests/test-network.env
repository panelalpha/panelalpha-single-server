# The networks every test takes its scenario addresses from: PHPUnit
# (Tests\Support\TestNetwork) and the Dusk tests. An environment variable
# of the same name overrides a value for one run.
#
# The PUBLIC networks are RFC 5737 documentation ranges; ROUTABLE is a range
# that checks refusing documentation ranges still accept as public. The PRIVATE
# networks are ranges a real LAN is unlikely to use.
TEST_NET_PUBLIC=203.0.113.0/24
TEST_NET_PUBLIC_2=198.51.100.0/24
TEST_NET_PUBLIC_3=192.0.2.0/24
TEST_NET_ROUTABLE=93.184.216.0/24
TEST_NET_PRIVATE=10.99.0.0/24
TEST_NET_PRIVATE_2=192.168.99.0/24
TEST_NET_CONTAINER=172.18.0.0/24
TEST_NET_CONTAINER_2=172.25.0.0/24
