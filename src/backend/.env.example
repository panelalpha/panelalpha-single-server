# APP_NAME=Laravel
# APP_ENV=production
APP_KEY=
APP_DEBUG=
APP_URL=http://127.0.0.1:9080

# APP_LOCALE=en
# APP_FALLBACK_LOCALE=en
# APP_FAKER_LOCALE=en_US

# APP_MAINTENANCE_DRIVER=file
# # APP_MAINTENANCE_STORE=database

# # PHP_CLI_SERVER_WORKERS=4

# BCRYPT_ROUNDS=12

# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_DEPRECATIONS_CHANNEL=null
# LOG_LEVEL=debug

# DB_CONNECTION=sqlite
# # DB_HOST=127.0.0.1
# # DB_PORT=3306
# # DB_DATABASE=laravel
# # DB_USERNAME=root
# # DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# SPA cookie auth (CA/AA via nginx :9080/:9081)
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:9080,localhost:9081,127.0.0.1,127.0.0.1:9080,127.0.0.1:9081
SANCTUM_PREFIX=api

BROADCAST_CONNECTION=reverb
# FILESYSTEM_DISK=local
# The container runs a queue worker and the scheduler.
QUEUE_CONNECTION=database

# Nginx trusts X-Forwarded-For only from these front-proxy CIDR
# ranges (comma separated). Empty - the default - trusts no proxy, so
# `$remote_addr` is the TCP peer and a client cannot spoof its IP. Set it only
# when a real reverse proxy sits in front of the container, and list that
# proxy's ranges - never a broad Docker range. The panel trusts only the
# container nginx itself (127.0.0.1 / ::1).
# TRUSTED_FRONT_PROXIES=

# CACHE_STORE=database
# # CACHE_PREFIX=

# MEMCACHED_HOST=127.0.0.1

# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# MAIL_MAILER=log
# MAIL_SCHEME=null
# MAIL_HOST=127.0.0.1
# MAIL_PORT=2525
# MAIL_USERNAME=null
# MAIL_PASSWORD=null
# MAIL_FROM_ADDRESS="hello@example.com"
# MAIL_FROM_NAME="${APP_NAME}"

# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_USE_PATH_STYLE_ENDPOINT=false

# VITE_APP_NAME="${APP_NAME}"

# Social login. A provider appears on the login screen only when
# both credentials are set; only laravel/socialite core drivers are supported.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=

# Password policy. `uncompromised` calls the external HIBP API;
# keep it off unless a production deployment opts in.
# PASSWORD_UNCOMPROMISED=false

# Require a recent password confirmation (window
# PASSWORD_CONFIRM_2FA_SECONDS, 423 while unconfirmed) before the two-factor
# routes. On by default; a password login confirms the session.
# REQUIRE_PASSWORD_FOR_2FA=true

# Reverb (Pusher-compatible). The app id and signing secret are generated once
# per install into /app/data and rendered into .env by entrypoint.sh. The
# public key must equal the Client Area's hard-coded Echo key
# (packages/client-area/src/apis/Auth.js:340), so it is one fixed compatibility
# value, not a per-install secret.
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
