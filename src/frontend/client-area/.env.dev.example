DEV_HOST=
DEV_PORT=2140
API_HOST=
API_PORT=8443
# API_PROXY=https://panel.example.com: Vite proxies /api and /ws to that panel (same origin in the browser, for a panel
# whose CORS does not allow credentials). API_HOST / API_PORT are then ignored; the websocket defaults to DEV_HOST / DEV_PORT.
API_PROXY=
WEBSOCKET_HOST=
WEBSOCKET_PORT=
# Echo websocket. docker-npm-dev.sh turns WEBSOCKET_HOST / WEBSOCKET_PORT into VITE_WEBSOCKET_HOST / VITE_WEBSOCKET_PORT
# (default: API_HOST / API_PORT, as legacy). Optional Vite-only overrides (set in the environment or a Vite .env file):
#   VITE_WEBSOCKET_AUTH_ENDPOINT  default ${VITE_API_URL}/broadcasting/auth
#   VITE_WEBSOCKET_PATH           default /ws
#   (VITE_WEBSOCKET_HOST / VITE_WEBSOCKET_PORT without the script default to location.hostname and location port / 443 / 80)

# Parity harness (`npm run parity*`, see parity/README.md). Not read by docker-npm-dev.sh: export them in the shell.
# PARITY_LEGACY_URL=https://legacy.example.com            # deployed legacy client area (target app)
# PARITY_LEGACY_API_URL=https://legacy.example.com:8443/api # its API, only for `npm run parity:fixtures`
# PARITY_LITE_URL=https://lite.example.com                 # deployed app-lite client area (target lite)
