{
  "name": "client-area-next",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "ui:scan": "node scripts/ui-contract/ui-scan.ts",
    "knip": "npx knip@5.88.1 --no-progress",
    "type-check": "vue-tsc --build --force",
    "test": "vitest run",
    "lint": "eslint .",
    "parity": "playwright test -c parity/playwright.config.ts",
    "parity:gate": "PARITY_GATE=1 playwright test -c parity/playwright.config.ts",
    "parity:quick": "PARITY_GATE=1 playwright test -c parity/playwright.config.ts --project light-desktop",
    "parity:serve": "VITE_API_URL=/api vite build && vite preview --port ${PARITY_NEXT_PORT:-4174} --strictPort",
    "parity:fixtures": "node parity/scripts/capture-fixtures.ts",
    "e2e": "playwright test",
    "demo:wizard": "playwright test -c playwright.demo.config.ts"
  },
