// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`wizard card frame DOM > Summary after the Hub: the included list 1`] = `"<section class="summary-hub"><h3 class="feature-flag" data-testid="wizard-summary-connect-head"><svg></svg> Included with PanelAlpha Hub</h3><ul class="feature-checks feature-checks--row"><li data-testid="wizard-summary-connect-line"><svg></svg><span>One login for all your servers</span></li><li data-testid="wizard-summary-connect-line"><svg></svg><span>One-click admin login</span></li><li data-testid="wizard-summary-connect-line"><svg></svg><span>App monitoring across your servers</span></li><li data-testid="wizard-summary-connect-line"><svg></svg><span>Verified apps from the PanelAlpha GO! catalog</span></li></ul></section>"`;

exports[`wizard card frame DOM > step 1: the Hub card 1`] = `"<div class="feature-card" data-testid="wizard-hub-card"><span class="feature-flag"><svg></svg> Recommended</span><div class="feature-card__main"><h3 class="feature-card__title">Connect with PanelAlpha Hub</h3><ul class="feature-checks feature-card__checks"><li><svg></svg><span>Account stored in Hub, not on this server</span></li><li><svg></svg><span>One login for many servers</span></li><li><svg></svg><span>Sign in with GitHub or Google</span></li><li><svg></svg><span>Install verified apps from the PanelAlpha GO! catalog</span></li></ul><button type="button" class="v-btn v-btn--block v-btn--elevated v-theme--light bg-primary v-btn--density-default elevation-0 v-btn--size-large v-btn--variant-elevated hub-card__button" data-testid="wizard-connect-button"><span class="v-btn__overlay"></span><span class="v-btn__underlay"></span><span class="v-btn__content" data-no-activator="">Connect with Hub <svg></svg></span></button></div><div class="hub-diagram" data-testid="wizard-hub-diagram"><img alt="This server joins your Hub account" class="hub-diagram__image" height="500" src="hub-diagram" width="960"></div></div>"`;

exports[`wizard card frame DOM > step 3: the card without a token 1`] = `"<div class="feature-card" data-testid="wizard-ai-status"><span class="feature-flag"><svg></svg> Works with any MCP client</span><div class="feature-card__main"><h3 class="feature-card__title" data-testid="wizard-ai-title">Connect with MCP</h3><ul class="feature-checks feature-card__checks"><li><svg></svg><span>Manage projects, domains and backups from your AI assistant</span></li><li><svg></svg><span>Check logs, errors and server usage without opening the panel</span></li><li><svg></svg><span>Revoke access at any time in Connect AI</span></li></ul><button type="button" class="v-btn v-btn--block v-btn--elevated v-theme--light bg-primary v-btn--density-default elevation-0 v-btn--size-large v-btn--variant-elevated" data-testid="wizard-ai-create"><span class="v-btn__overlay"></span><span class="v-btn__underlay"></span><span class="v-btn__content" data-no-activator="">Create token</span></button></div><div class="ai-panel" data-testid="wizard-ai-panel"><div aria-hidden="true" class="ai-panel__diagram"><span class="ai-panel__node"><svg></svg> Your AI assistant</span><span class="ai-panel__link"><span class="ai-panel__chip">MCP + token</span><span class="ai-panel__line"></span></span><span class="ai-panel__node ai-panel__node--server"><svg></svg> This server</span></div><div class="ai-panel__address"><span class="ai-panel__label">MCP server address</span><div class="ai-panel__field"><code data-testid="wizard-ai-address">http://localhost:3000/mcp</code><div><button type="button" class="v-btn v-btn--icon v-theme--light v-btn--density-default v-btn--size-x-small v-btn--variant-text copyButton ml-2" style="color: var(--v-wizard-accent); caret-color: var(--v-wizard-accent);" aria-label="button.copy" aria-haspopup="menu" aria-expanded="false" aria-owns="v-menu-v-1"><span class="v-btn__overlay"></span><span class="v-btn__underlay"></span><span class="v-btn__content" data-no-activator=""><i class="v-icon notranslate v-theme--light" style="font-size: 16px; height: 16px; width: 16px; color: var(--v-wizard-accent); caret-color: var(--v-wizard-accent);" aria-hidden="true"><div><svg></svg></div></i></span></button></div></div></div></div></div>"`;

exports[`wizard card frame DOM > step 3: the connected card 1`] = `"<div class="feature-card feature-card--ok" data-testid="wizard-ai-status"><span class="feature-flag"><svg></svg> Connected</span><div class="feature-card__main"><h3 class="feature-card__title" data-testid="wizard-ai-connected">AI is connected to this panel.</h3><ul class="feature-checks feature-card__checks"><li><svg></svg><span>Manage projects, domains and backups from your AI assistant</span></li><li><svg></svg><span>Check logs, errors and server usage without opening the panel</span></li><li><svg></svg><span>Revoke access at any time in Connect AI</span></li></ul><button type="button" class="v-btn v-btn--block v-theme--light text-gray v-btn--density-default elevation-0 v-btn--size-large v-btn--variant-outlined" data-testid="wizard-ai-create"><span class="v-btn__overlay"></span><span class="v-btn__underlay"></span><span class="v-btn__content" data-no-activator="">Create another token</span></button></div><div class="ai-panel" data-testid="wizard-ai-panel"><div aria-hidden="true" class="ai-panel__diagram"><span class="ai-panel__node"><svg></svg> Your AI assistant</span><span class="ai-panel__link"><span class="ai-panel__chip">MCP + token</span><span class="ai-panel__line"></span></span><span class="ai-panel__node ai-panel__node--server"><svg></svg> This server</span></div><div class="ai-panel__address"><span class="ai-panel__label">MCP server address</span><div class="ai-panel__field"><code data-testid="wizard-ai-address">http://localhost:3000/mcp</code><div><button type="button" class="v-btn v-btn--icon v-theme--light v-btn--density-default v-btn--size-x-small v-btn--variant-text copyButton ml-2" style="color: var(--v-wizard-accent); caret-color: var(--v-wizard-accent);" aria-label="button.copy" aria-haspopup="menu" aria-expanded="false" aria-owns="v-menu-v-1"><span class="v-btn__overlay"></span><span class="v-btn__underlay"></span><span class="v-btn__content" data-no-activator=""><i class="v-icon notranslate v-theme--light" style="font-size: 16px; height: 16px; width: 16px; color: var(--v-wizard-accent); caret-color: var(--v-wizard-accent);" aria-hidden="true"><div><svg></svg></div></i></span></button></div></div></div></div></div>"`;
