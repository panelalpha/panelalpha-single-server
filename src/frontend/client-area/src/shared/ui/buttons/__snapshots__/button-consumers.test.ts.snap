  ":loading="instance.hasUpdateInProgress()" @click="onUpdateClick" block class="font-weight-bold text-white" key="update" v-else-if="(wordpress.updateAvailable || woocommerce.updateAvailable) && instance.hasWordPressUpdatePrivilege()" | button.wordpress.update, button.woocommerce.update",
]
`;

