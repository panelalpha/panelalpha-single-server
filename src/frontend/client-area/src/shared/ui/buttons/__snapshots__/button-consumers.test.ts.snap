exports[`button consumers keep their wiring (kit-button-rest) > src/views/projects/project/topbar/SetYourDomainModal.vue 1`] = `
[
  ":loading="loading" @click="loadModal" class="mr-4 change-domain-btn dns-propagation-btn" data-testid="instance-dns-propagation" v-if="dnsMismatch" | message.dnsPropagationInProgress",
  ":loading="loading" @click="loadModal" class="mr-4 change-domain-btn" data-testid="instance-change-domain" v-else-if="instance.hasChangeDomainPrivilege()" | button.setDomain.changeDomain",
  ":loading="submitting" @click="submitForm" block class="set-domain-submit" data-testid="set-domain-use" | button.setDomain.useThisDomain",
  "@click="isOpen = false" block class="mt-2" data-testid="set-domain-cancel" | button.cancel",
  "@click="step = 0" class="set-domain-change" data-testid="set-domain-change" v-if="instance.hasChangeDomainPrivilege()" | button.change",
  "@click="openPreview" class="set-domain-preview-button" data-testid="set-domain-preview-button" | heading.instance.modal.setDomain.generateUrl",
  "@click="isOpen = false" block class="set-domain-close-action" data-testid="set-domain-close-action" | button.close",
  ":loading="submitting" @click="nextStep" block class="set-domain-submit" data-testid="set-domain-transfer-now" | button.transferNow",
  "@click="isOpen = false" block class="mt-2" data-testid="set-domain-transfer-cancel" | button.cancel",
  "@click="isOpen = false" block class="set-domain-close-action" data-testid="set-domain-transfer-cancel" | button.cancel",
  ":loading="submitting" @click="verifyDnsPropagation()" block class="set-domain-submit" data-testid="set-domain-verify-button" v-if="!verification.isVerificationSuccessful" | button.verifyDomain",
  ":loading="submitting" @click="nextStep" block class="set-domain-submit" data-testid="set-domain-change-confirm" v-else | button.setDomain.changeDomain",
  "@click="changeDomain" block class="mt-2" data-testid="set-domain-skip" v-if="!verification.isVerificationSuccessful" | button.skip",
]
`;

