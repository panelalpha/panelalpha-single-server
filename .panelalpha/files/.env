# The Engine copies this file to the project's `.env`, which its generated
# compose passes to the container as `env_file:`. It stays almost empty on
# purpose: every key the panel needs at runtime is in the `env:` block of
# panelalpha.yaml, which outranks `env_file:`. Keep database, Redis, Pusher,
# cache and queue keys out of it (PanelalphaConfigTest checks).
APP_NAME=PanelAlpha
